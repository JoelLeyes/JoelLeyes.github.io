flowchart TB
    subgraph CLIENTES["CLIENTES Y PRUEBAS"]
        usuarios("Usuarios web<br/>Operador · Comercio · Destinatario")
        movil("Repartidores<br/>MAUI Android · SQLite offline")
        k6("Grafana k6 · Docker<br/>Pruebas de carga por HTTPS")
    end
    dns("ClouDNS · DNS externo<br/>*.tallernet.cloud-ip.cc")
    subgraph AWS["AWS · us-east-1 · VPC 172.31.0.0/16"]
        alb("Entrada segura · ALB + ACM<br/>HTTPS 443 · Certificado wildcard<br/>HTTP 80 redirige a HTTPS")
        subgraph EKS["EKS 1.34 · 2 nodos t3.medium · namespace tallernet"]
            nginx("NGINX Ingress · 2 replicas<br/>NodePort 32080 · Ruteo por dominio<br/>Services internos → contenedores HTTP 8080")
            web("Backoffice + API · .NET 10<br/>Razor Pages · SignalR<br/>Tambien recibe backoffice.*")
            portal("Portal Blazor · 2 pods<br/>app: portal del comercio<br/>tracking: seguimiento publico")
            hpa("HPA + metrics-server<br/>Backoffice: 2–4 pods · CPU 70 %<br/>Portal: 2 pods fijos")
            redis[("Redis · 1 replica<br/>Cache · Claves Data Protection<br/>Backplane SignalR")]
            rabbit[("RabbitMQ · 1 instancia<br/>Eventos · Reintentos · Colas de fallidos<br/>Sin volumen persistente")]
            worker("Queue Worker · 1 pod<br/>Avisos · Correo · Push · Historial<br/>Tareas programadas")
            lgtm("OpenTelemetry → Grafana LGTM<br/>Logs: Loki · Trazas: Tempo<br/>Metricas: Prometheus · 1 pod")
        end
        rds[("Amazon RDS · PostgreSQL 16.9<br/>db.t3.micro · Single-AZ · 20 GiB<br/>Privado · SSL · Almacenamiento cifrado")]
    end
    subgraph EXTERNOS["SERVICIOS EXTERNOS A AWS DEL LABORATORIO"]
        atlas[("MongoDB Atlas<br/>Historial de eventos · TLS<br/>Indices · Retencion TTL")]
        notificaciones("Firebase FCM / SMTP<br/>Push Android / Correo")
        comercios("Sistemas de comercios<br/>Webhooks firmados con HMAC")
    end
    usuarios -->|HTTPS| alb
    movil -->|HTTPS / JWT| alb
    k6 -->|HTTPS| alb
    dns -.->|CNAME| alb
    alb -->|HTTP 32080| nginx
    nginx -->|"api.<br/>tallernet.cloud-ip.cc"| web
    nginx -->|"app.<br/>tallernet.cloud-ip.cc"| portal
    nginx -->|"tracking.<br/>tallernet.cloud-ip.cc"| portal
    hpa -.->|Escala Backoffice| web
    web -->|SQL 5432| rds
    web -->|TCP 6379| redis
    web -->|Outbox / AMQP| rabbit
    portal -->|SQL 5432| rds
    portal -->|TCP 6379| redis
    portal -->|Outbox / AMQP| rabbit
    rabbit -->|Eventos / ack manual| worker
    worker -->|SQL 5432| rds
    worker -->|Escritura TLS| atlas
    web -->|Backoffice: lectura TLS| atlas
    worker --> notificaciones
    worker -->|HTTP / HMAC| comercios
    web -.->|OTLP| lgtm
    portal -.->|OTLP| lgtm
    worker -.->|OTLP| lgtm
