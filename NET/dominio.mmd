%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Trebuchet MS, Verdana, Arial, sans-serif", "fontSize": "16px", "primaryColor": "#ECECFF", "primaryTextColor": "#333333", "primaryBorderColor": "#9370DB", "lineColor": "#5b21b6"}}}%%
classDiagram
    direction TB

    class Operador {
        Int Id
        String RazonSocial
        String IdentidadVisual
        Bool Activo
    }
    class Comercio {
        Int Id
        String NombreComercial
        String RazonSocial
        String DocumentoFiscal
        DtDireccion DireccionPrincipal
        Bool Activo
    }
    class Usuario {
        Int Id
        String Nombre
        String Email
        String PasswordHash
        Rol Rol
    }
    class Envio {
        Int Id
        String NumeroDeSeguimiento
        String TokenSeguimientoPublico
        EstadoEnvio Estado
        Modalidad Modalidad
        Float TarifaCalculada
        Time CreadoEn
    }
    class Bulto {
        Int Id
        String CodigoIdentificacion
        Float PesoKg
        DtDimensiones Dimensiones
        Bool RecibidoEnDeposito
    }
    class Destinatario {
        Int Id
        String NombreCompleto
        String Documento
        String Telefono
        DtDireccion DireccionEntrega
    }
    class EventoEnvio {
        Int Id
        String Tipo
        String Origen
        String Responsable
        Coordenada Geolocalizacion
        Time OcurridoEn
    }
    class IntentoEntrega {
        Int Id
        Bool Exitoso
        Time FechaHora
    }
    class PruebaDeEntrega {
        Int Id
        String Firma
        String Foto
        String NombreReceptor
        String DocumentoReceptor
        Coordenada Geolocalizacion
        Time CapturadoEn
    }
    class MotivoNoEntrega {
        Int Id
        String Descripcion
        Bool RequiereReprogramacionAutomatica
        Bool Activo
    }
    class Devolucion {
        Int Id
        String Motivo
        EstadoDevolucion Estado
        Time IniciadaEn
    }
    class ZonaCobertura {
        Int Id
        String Nombre
        String Poligono
    }
    class FranjaHoraria {
        Int Id
        String Nombre
        Time HoraInicio
        Time HoraFin
    }
    class Vehiculo {
        Int Id
        String Patente
        Float CapacidadPesoKg
        Float CapacidadVolumenM3
        Bool Activo
    }
    class Ruta {
        Int Id
        DateTime Fecha
        EstadoRuta Estado
    }
    class Parada {
        Int Id
        Int IntentoDeEntrega
        Int Orden
        DateTime CompletadaEn
    }
    class VersionTarifa {
        Int Id
        DateTime VigenteDesde
        DateTime VigenteHasta
    }
    class ReglaTarifaria {
        Int Id
        Modalidad Modalidad
        Float RangoPesoMinKg
        Float RangoPesoMaxKg
        Float PrecioBase
        Float PrecioPorKgExtra
        Float RecargoUrgente
        Float Bonificacion
    }
    class VersionReglaOperativa {
        Int Id
        Int MaximoIntentos
        Int PlazoEntreIntentosHoras
        Bool ExigeFirma
        Bool ExigeFoto
        Bool ExigeDocumento
        Int PlazoComprometidoHorasEstandar
        Int PlazoComprometidoHorasUrgente
        DateTime VigenteDesde
        DateTime VigenteHasta
    }
    class SuscripcionAviso {
        Int Id
        EstadoEnvio TipoEvento
        String UrlWebhook
        String Secreto
    }
    class AvisoComercio {
        Int Id
        String PayloadJson
        EstadoAvisoComercio Estado
        Int CantidadIntentos
        Time ProximoIntentoEn
    }
    class Incidencia {
        Int Id
        String Descripcion
        EstadoIncidencia Estado
        Time CreadaEn
    }
    class Liquidacion {
        Int Id
        Time PeriodoDesde
        Time PeriodoHasta
        Float MontoTotal
        Bool Cerrada
    }

    Operador "1" --> "0..*" Comercio : atiende
    Operador "1" --> "1..*" Usuario : tiene cuenta
    Comercio "0..1" --> "0..*" Usuario : tiene
    Operador "1" --> "0..*" ZonaCobertura : delimita
    Operador "1" --> "0..*" VersionTarifa : define
    Operador "1" --> "0..*" VersionReglaOperativa : establece
    Operador "1" --> "0..*" Vehiculo : posee
    Operador "1" --> "0..*" MotivoNoEntrega : configura
    Operador "1" --> "0..*" Ruta : planifica
    Operador "1" --> "0..*" Destinatario : registra
    Operador "1" --> "0..*" Incidencia : gestiona
    Comercio "1" --> "0..*" Envio : solicita
    Comercio "1" --> "0..*" SuscripcionAviso : parametriza
    Comercio "1" --> "0..*" Liquidacion : recibe
    Usuario "1" --> "0..*" Ruta : asignado
    Usuario "1" --> "0..*" IntentoEntrega : ejecutado
    Envio "1" --> "1..*" Bulto : contiene
    Envio "1" --> "1" Destinatario : se dirige
    Envio "1" --> "1..*" EventoEnvio : historial
    Envio "1" --> "0..*" IntentoEntrega : registra
    Envio "1" --> "0..1" Devolucion : procesa
    Envio "1" --> "1..*" Parada : procesa
    Envio "1" --> "0..*" Incidencia : reporta
    Envio "0..*" --> "1" VersionTarifa : aplica
    IntentoEntrega "1" --> "0..1" PruebaDeEntrega : evidencia
    IntentoEntrega "1" --> "0..1" MotivoNoEntrega : causa falla
    ZonaCobertura "1" --> "1..*" FranjaHoraria : ofrece
    ZonaCobertura "1" --> "0..*" ReglaTarifaria : tiene
    VersionTarifa "1" --> "0..*" ReglaTarifaria : tiene
    Ruta "1" --> "1..*" Parada : compone
    Ruta "1" --> "0..*" Vehiculo : asigna
    SuscripcionAviso "1" --> "0..*" AvisoComercio : genera
